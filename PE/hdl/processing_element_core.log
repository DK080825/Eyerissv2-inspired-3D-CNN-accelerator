wire                               iact_data_spad_write_fin_int;
reg  [IACT_DATA_PTR_W-1:0]         iact_data_read_idx_q;
wire [IACT_DATA_W-1:0]             iact_data_spad_data_out;

wire                               weight_address_spad_data_in_ready;
wire                               weight_address_spad_write_fin_int;
