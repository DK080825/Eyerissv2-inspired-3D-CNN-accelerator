    .wr_en0          (psum_wr_en0_q),
    .wr_addr0        (psum_wr_addr0_q),
    .wr_data0        (psum_wr_data0_q),
    .wr_en1          (psum_wr_en1_q),
    .wr_addr1        (psum_wr_addr1_q),
    .wr_data1        (psum_wr_data1_q),
