        s5_lane0_valid_q         <= 1'b0;
        s5_lane1_valid_q         <= 1'b0;
        s5_psum_addr0_q          <= {PSUM_ADDR_W{1'b0}};
        s5_psum_addr1_q          <= {PSUM_ADDR_W{1'b0}};
        s5_old_psum0_q           <= {PSUM_W{1'b0}};
        s5_old_psum1_q           <= {PSUM_W{1'b0}};
