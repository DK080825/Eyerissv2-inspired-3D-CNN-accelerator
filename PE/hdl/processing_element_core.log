// load bookkeeping
// -----------------------------------------------------------------------------
always @(posedge clock) begin
    if (reset) begin
        load_en_q               <= 1'b0;
        iact_addr_entry_count_q <= {(IACT_SEG_IDX_W+1){1'b0}};
